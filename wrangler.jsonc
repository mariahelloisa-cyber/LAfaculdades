{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lafaculdades",
  "main": ".open-next/worker.js",
  /* Build: npm run deploy já executa opennextjs-cloudflare build antes.
     Remover este bloco evita dupla compilação e garante que cache e
     Worker pertencem ao MESMO build. */
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  /* Cache incremental do Next (ISR). Sem ele o Worker re-renderiza cada página
     do zero a cada visita, o que estourava o limite de memória (erro 1102). */
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "39e9ce701cf446a89a0e53ef0b4d15e1"
    }
  ],
  /* Guarda quando cada tag foi revalidada — é o que faz o revalidatePath()
     das ações do admin realmente invalidar as páginas já cacheadas. */
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "lafaculdades-cache-tags",
      "database_id": "29e4d0c6-8c9b-4937-a8ab-690a7d4d1809"
    }
  ],
  /* Fila que regenera a página em segundo plano quando ela vence, para o
     visitante nunca esperar o re-render. */
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"]
    }
  ],
  /* Limite de envios por IP (proteção contra abuso). Contador da própria
     Cloudflare, por localidade — não é memória do Worker. period: 10 ou 60 s.
     namespace_id: qualquer número, único dentro da conta. */
  "ratelimits": [
    {
      "name": "RL_FORMULARIOS",
      "namespace_id": "4201",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "RL_LOGIN",
      "namespace_id": "4202",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  /* Secrets (NÃO ficam aqui; `npx wrangler secret put <NOME>`):
     - TURNSTILE_SECRET            chave secreta do widget Turnstile
     - CHAVE_GRAVACAO_MATRICULAS   gerada por supabase/seguranca-v07-chave.sql */
  "vars": {
    /* Domínios onde o widget roda, separados por vírgula (ex.:
       "lafaculdades.com.br,www.lafaculdades.com.br"). Sem localhost aqui.
       Enquanto for este marcador, os formulários recusam todo envio. */
    "TURNSTILE_HOSTNAMES": "lafaculdades.maria-helloisa.workers.dev,facla.edu.br",
    "NEXT_PUBLIC_SUPABASE_URL": "https://nfklgwtncdaoembrmiar.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5ma2xnd3RuY2Rhb2VtYnJtaWFyIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODgxNjc2MjgsImV4cCI6MjEwMzc0MzYyOH0.jXIvp7TJL9mUHJwaxu6IEDFo_kOlIwsJosfNpn7WqeU"
  },
  "observability": {
    "enabled": true
  }
}
